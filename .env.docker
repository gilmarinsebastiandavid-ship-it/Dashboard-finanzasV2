# Variables de entorno para Docker Compose
# Renombrar este archivo a .env antes de usar

# Contraseña de PostgreSQL
DB_PASSWORD=postgres123

# Puerto del Frontend (se mapea al puerto 80 interno de nginx)
FRONTEND_PORT=8000

# Puerto del Backend
BACKEND_PORT=3001

# Puerto de PostgreSQL
POSTGRES_PORT=5432

# URL de la API (para producción, cambiar a tu dominio)
# Ejemplo: https://api.tu-dominio.com/api
REACT_APP_API_URL=http://localhost:3001/api
